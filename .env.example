# Copy to .env (which git ignores) and fill in. Never commit a real key.
OPENAI_API_KEY=
# Optional: which OpenAI model writes the AI reading.
# OPENAI_MODEL=gpt-6-astra
# Optional: "fast" (the default here) is quicker and billed at a higher rate; "default" is standard.
# OPENAI_SERVICE_TIER=fast
# Optional: how hard the model thinks before answering. Lower is quicker.
# OPENAI_REASONING_EFFORT=low
